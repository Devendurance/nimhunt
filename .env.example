# Server-only Supabase credentials for the daily expedition ledger.
# NEVER prefix these with VITE_. NEVER import them from src/.
# The service-role key must not ship to the browser or enter Git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias accepted by the server adapter. Never prefix with VITE_.
# SUPABASE_SECRET_KEY=your-service-role-key
# Optional: server-test anon key for active RLS rejection tests. Never prefix with VITE_.
# SUPABASE_ANON_KEY=your-anon-key
NIMHUNT_PROOF_BACKEND=disabled
NIMHUNT_APP_ORIGIN=http://localhost:5173

# Optional: set to 1 to run server/ledger/postgres.integration.test.ts against a live project.
NIMHUNT_LEDGER_INTEGRATION=0
# Optional: set to 1 to run server/expeditions/postgres.integration.test.ts against configured Supabase.
NIMHUNT_PROOF_INTEGRATION=0
# Dev-only. Never enable in product/preview. Required to run npm run dev:reset-expeditions.
# NIMHUNT_ENABLE_DEV_RESET=false
