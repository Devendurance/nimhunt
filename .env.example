# Server-only Supabase credentials for the daily expedition ledger.
# NEVER prefix these with VITE_. NEVER import them from src/.
# The service-role key must not ship to the browser or enter Git.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias accepted by the server adapter. Never prefix with VITE_.
# SUPABASE_SECRET_KEY=your-service-role-key
# Optional: server-test anon key for active RLS rejection tests. Never prefix with VITE_.
# SUPABASE_ANON_KEY=your-anon-key
NIMHUNT_PROOF_BACKEND=disabled
NIMHUNT_APP_ORIGIN=http://localhost:5173

# Optional: set to 1 to run server/ledger/postgres.integration.test.ts against a live project.
NIMHUNT_LEDGER_INTEGRATION=0
# Optional: set to 1 to run server/expeditions/postgres.integration.test.ts against configured Supabase.
NIMHUNT_PROOF_INTEGRATION=0
# Dev-only. Never enable in product/preview. Required to run npm run dev:reset-expeditions.
# NIMHUNT_ENABLE_DEV_RESET=false

# Server-only NIM payout execution. Never prefix these with VITE_. Never commit real secrets.
# Default execution is fail-closed without an explicit network.
# NIMHUNT_PAYOUT_NETWORK=testnet
# NIMHUNT_ENABLE_MAINNET_PAYOUT=false
# Unattended payout execution. Requires NIMHUNT_ENABLE_MAINNET_PAYOUT=true AND this flag AND DB payout_automation_control.
# NIMHUNT_AUTOMATIC_PAYOUTS_ENABLED=false
# Integer Luna only. 1 NIM = 100000 Luna. Beta reward is 100 NIM = 10000000 Luna.
# NIMHUNT_REWARD_AMOUNT_LUNA=10000000
# Integer Luna cap for 69 daily rewards. Fail closed if amount * 69 exceeds this.
# NIMHUNT_MAX_DAILY_REWARD_LUNA=690000000
# Integer Luna to keep in the treasury. Do not acquire if the next payout plus fee would breach this.
# Next rollout checkpoint: 100 NIM = 10000000 Luna. Do not fund the treasury to satisfy this.
# NIMHUNT_TREASURY_MIN_RESERVE_LUNA=10000000
# NIMHUNT_TREASURY_PRIVATE_KEY=
# NIMHUNT_TREASURY_MNEMONIC=
# Vercel-native cron auth. Set CRON_SECRET in the Vercel project environment (server-only,
# never VITE_*). Vercel Cron then sends `Authorization: Bearer <CRON_SECRET>` to the
# configured cron path. This is the single canonical production secret.
# CRON_SECRET=
# Local/dev alias only. Production must use CRON_SECRET, not this alias.
# Do not set both with identical values in production.
# NIMHUNT_PAYOUT_CRON_SECRET=
# Maximum payouts one scheduled cycle may acquire. Defaults to 5; valid range is 1-69.
# NIMHUNT_PAYOUT_MAX_PER_CYCLE=5
# Optional: set to 1 to run server/payouts/testnet.integration.test.ts against Nimiq testnet.
# NIMHUNT_PAYOUT_TESTNET=0
