{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/payout-cycle",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/api/daily-hunt-status",
      "destination": "/api/product?__nimhunt_route=/api/daily-hunt-status"
    },
    {
      "source": "/api/wallet-daily-status",
      "destination": "/api/product?__nimhunt_route=/api/wallet-daily-status"
    },
    {
      "source": "/api/expeditions/:path*",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/:path*"
    },
    {
      "source": "/api/rewards/:path*",
      "destination": "/api/product?__nimhunt_route=/api/rewards/:path*"
    },
    {
      "source": "/api/monthly-heroes",
      "destination": "/api/product?__nimhunt_route=/api/monthly-heroes"
    },
    {
      "source": "/api/wallet/monthly-stats",
      "destination": "/api/product?__nimhunt_route=/api/wallet/monthly-stats"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "/api/product?__nimhunt_route=/api/wallet/:path*"
    }
  ]
}
