    {
      "source": "/api/rewards/claim/finalize",
      "destination": "/api/product?__nimhunt_route=/api/rewards/claim/finalize"
    },
    {
      "source": "/api/rewards/claim/payout",
      "destination": "/api/product?__nimhunt_route=/api/rewards/claim/payout"
    },
    {
      "source": "/api/rewards/reserve",
      "destination": "/api/product?__nimhunt_route=/api/rewards/reserve"
    },
    {
      "source": "/api/wallet/recover-challenge",
      "destination": "/api/product?__nimhunt_route=/api/wallet/recover-challenge"
    },
    {
      "source": "/api/wallet/recover-session",
      "destination": "/api/product?__nimhunt_route=/api/wallet/recover-session"
    },
    {
      "source": "/api/wallet/treasure-bank",
      "destination": "/api/product?__nimhunt_route=/api/wallet/treasure-bank"
    },
    {
      "source": "/api/wallet/monthly-stats",
      "destination": "/api/product?__nimhunt_route=/api/wallet/monthly-stats"
    },
    {
      "source": "/api/monthly-heroes",
