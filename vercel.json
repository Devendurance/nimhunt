{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/payout-cycle",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/api/daily-hunt-status",
      "destination": "/api/product?__nimhunt_route=/api/daily-hunt-status"
    },
    {
      "source": "/api/wallet-daily-status",
      "destination": "/api/product?__nimhunt_route=/api/wallet-daily-status"
    },
    {
      "source": "/api/expeditions/start-challenge",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/start-challenge"
    },
    {
      "source": "/api/expeditions/start",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/start"
    },
    {
      "source": "/api/expeditions/active",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/active"
    },
    {
      "source": "/api/expeditions/session/recover",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/session/recover"
    },
    {
      "source": "/api/expeditions/gameplay-start",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/gameplay-start"
    },
    {
      "source": "/api/expeditions/checkpoint",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/checkpoint"
    },
    {
      "source": "/api/expeditions/verify",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/verify"
    },
    {
      "source": "/api/expeditions/abandon",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/abandon"
    },
    {
      "source": "/api/expeditions/vault-seal/prepare",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/vault-seal/prepare"
    },
    {
      "source": "/api/expeditions/vault-seal/verify",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/vault-seal/verify"
    },
    {
      "source": "/api/expeditions/complete",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/complete"
    },
    {
      "source": "/api/expeditions/fail",
      "destination": "/api/product?__nimhunt_route=/api/expeditions/fail"
